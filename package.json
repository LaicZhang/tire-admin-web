{
  "name": "pure-admin-thin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite --host 0.0.0.0",
    "dev:future": "VITE_FUTURE=1 pnpm dev",
    "serve": "pnpm dev",
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:future": "VITE_FUTURE=1 pnpm build",
    "build:staging": "rimraf dist && vite build --mode staging",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck --incremental --tsBuildInfoFile node_modules/.cache/typecheck/admin.tsbuildinfo",
    "typecheck:watch": "vue-tsc --watch --noEmit --skipLibCheck --incremental --tsBuildInfoFile node_modules/.cache/typecheck/admin-watch.tsbuildinfo",
    "audit:type-safety": "node scripts/check-type-safety-critical.mjs",
    "svgo": "svgo -f . -r",
    "cloc": "NODE_OPTIONS=--max-old-space-size=4096 cloc . --exclude-dir=node_modules --exclude-lang=YAML",
    "audit:drift": "node scripts/audit-drift-check.mjs",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:eslint:check": "eslint --cache \"{src,mock,build}/**/*.{vue,js,ts,tsx}\"",
    "format": "oxfmt --write \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint:stylelint:check": "stylelint --cache \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm format",
    "lint:check": "pnpm lint:eslint:check && pnpm lint:stylelint:check && pnpm format:check",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c playwright.mock.config.ts",
    "test:e2e:real": "playwright test -c playwright.config.ts",
    "test:e2e:ui": "playwright test -c playwright.mock.config.ts --ui",
    "test:e2e:debug": "playwright test -c playwright.mock.config.ts --debug",
    "test:e2e:real:ui": "playwright test -c playwright.config.ts --ui",
    "test:e2e:real:debug": "playwright test -c playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:8848",
    "preinstall": "node scripts/check-node-version.mjs && node scripts/only-allow-pnpm.mjs"
  },
  "keywords": [
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "homepage": "https://tire.laiczhang.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laiczhang/tire-admin-web"
  },
  "license": "MIT",
  "author": {
    "name": "laiczhang",
    "email": "laiczhang@outlook.com",
    "url": "https://github.com/laiczhang"
  },
  "dependencies": {
    "@pureadmin/descriptions": "^1.2.1",
    "@pureadmin/table": "^3.3.0",
    "@pureadmin/utils": "^2.6.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "axios": "1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.6",
    "idb-keyval": "^6.3.0",
    "js-cookie": "^3.0.8",
    "localforage": "^1.10.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.4",
    "plus-pro-components": "^0.1.31",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.7",
    "unstorage": "^1.17.5",
    "uuid": "^14.0.2",
    "vue": "^3.5.43",
    "vue-demi": "^0.14.10",
    "vue-router": "^5.3.1",
    "vue-tippy": "^6.8.0",
    "vue-types": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/json": "^2.2.532",
    "@iconify/vue": "5.0.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.13.6",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "boxen": "^9.0.0",
    "cloc": "^2.11.0",
    "code-inspector-plugin": "^2.0.9",
    "cssnano": "^9.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "gradient-string": "^3.0.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.70.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-load-config": "^6.0.1",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-router-warn": "^2.0.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.5.1"
}
